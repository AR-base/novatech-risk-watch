{
  // Cloudflare Worker that keeps the Claude API key secret for NOVATECH Risk Watch.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novatech-ai",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://ar-base.github.io"
  }
}
