{
  // Cloudflare Worker "novatech-risk-watch": the AI server that keeps the Claude API key secret.
  // Cloudflare builds this automatically from GitHub on every push; the website itself is served by GitHub Pages.
  // The Claude key is a Worker secret (ANTHROPIC_API_KEY) set in the Cloudflare dashboard, never in this file.
  "name": "novatech-risk-watch",
  "main": "ai-server/worker.js",
  "build": { "command": "node ai-server/write-build-key.mjs" },
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // Every minute: continuous phone reminders while a risk alert is open (ai-server/notify.js)
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "https://ar-base.github.io"
  }
}
